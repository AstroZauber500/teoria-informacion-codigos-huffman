# Byte-compilado / optimizado / DLL
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales
venv/
env/
.venv/
.env

# Distribución / empaquetado
build/
dist/
*.egg-info/

# Pruebas y cobertura
.pytest_cache/
.coverage
htmlcov/

# Salidas generadas por la simulación (se conserva la estructura de carpetas)
sim/codificacion/*
sim/decodificacion/*
sim/logs/*
!sim/codificacion/.gitkeep
!sim/decodificacion/.gitkeep
!sim/logs/.gitkeep

# Reportes generados
reporte/*
!reporte/.gitkeep

# IDEs y sistema operativo
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
